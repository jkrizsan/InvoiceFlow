{
  "realm": "invoiceflow",
  "displayName": "InvoiceFlow local development",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "invoice.read",
        "description": "Read invoices and PDFs"
      },
      {
        "name": "invoice.write",
        "description": "Create and change invoices"
      }
    ]
  },
  "clients": [
    {
      "clientId": "invoiceflow-api",
      "name": "InvoiceFlow API",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "enabled": true
    },
    {
      "clientId": "invoiceflow-cli",
      "name": "InvoiceFlow local API client",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "invoiceflow-demo-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "invoiceflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "invoiceflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-invoiceflow-cli",
      "enabled": true,
      "serviceAccountClientId": "invoiceflow-cli",
      "realmRoles": [
        "invoice.read",
        "invoice.write"
      ]
    }
  ]
}

